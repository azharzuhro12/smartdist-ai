# ==============================================================================
# SmartDist AI - Production Environment Configuration Template
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS OR PASSWORDS TO VERSION CONTROL!
# Copy this file to .env.production on the target host and customize values.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="SmartDist AI"
PROJECT_VERSION="0.1.0"
API_V1_STR="/api/v1"

# Security & Authentication (MANDATORY: Generate with `openssl rand -hex 32`)
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_OF_AT_LEAST_32_HEX_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Initial Administrator Seed (Change immediately upon initial deployment)
INITIAL_ADMIN_EMAIL=admin@enterprise-smartdist.internal
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_ADMIN_PASSWORD

# Rate Limiting Policies
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ASSISTANT_PER_MINUTE=30

# CORS Whitelist (JSON array of allowed production domains)
CORS_ORIGINS=["https://smartdist.example.com"]

# PostgreSQL Database Configuration (Least-Privilege Role Separation)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smartdist_db

# Runtime Application Role (DML only, no DDL/DROP)
POSTGRES_USER=smartdist_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD

# Dedicated Read-Only Role (SQL Assistant / BI queries - No write, no users table)
POSTGRES_READONLY_USER=smartdist_readonly
POSTGRES_READONLY_PASSWORD=REPLACE_WITH_STRONG_READONLY_PASSWORD

# Migration URL (Used strictly by Alembic / CI migrations under owner role)
POSTGRES_MIGRATION_URL=postgresql+psycopg2://smartdist_owner:REPLACE_WITH_STRONG_OWNER_PASSWORD@postgres:5432/smartdist_db

# Connection Pool Settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30

# Redis In-Memory Cache & Session Store
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=5.0

# Celery Task Broker & Backend
CELERY_BROKER_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

