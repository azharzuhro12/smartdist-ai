# ------------------------------------------------------------------------------
# SmartDist AI - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# ------------------------------------------------------------------------------

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="SmartDist AI"
PROJECT_VERSION="0.1.0"
API_V1_STR="/api/v1"

# CORS Configuration (JSON array of strings)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000","http://localhost:8035"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5435
POSTGRES_DB=smartdist_db
POSTGRES_USER=smartdist_user
POSTGRES_PASSWORD=smartdist_secure_password
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=smartdist_redis_pass
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=5.0

# Celery Configuration
# In docker-compose, broker and backend host should be 'redis'
# Example: redis://:smartdist_redis_pass@localhost:6380/1
CELERY_BROKER_URL=redis://:smartdist_redis_pass@localhost:6380/1
CELERY_RESULT_BACKEND=redis://:smartdist_redis_pass@localhost:6380/2
CELERY_TASK_ALWAYS_EAGER=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Host Port Mapping (Used by Docker Compose on the host machine)
HOST_BACKEND_PORT=8035
HOST_POSTGRES_PORT=5435
HOST_REDIS_PORT=6380
